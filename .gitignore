# Pipeline cache. Regenerated by `make all`.
_targets/

# The source dataset (45 MB) is fetched by R/01_data.R::fetch_data() rather
# than committed. Run `make data` to populate data/raw/.
data/raw/

# ---- Generated artefacts ARE tracked -----------------------------------------
# figures/ and reports/tables/ are committed deliberately. The README embeds
# the figures, so a reader who clones the repo sees the results without
# running anything. If you would rather track nothing generated, comment out
# these two lines and re-run `make all` -- but the README images will 404
# until someone regenerates them.
#
# reports/analysis.Rmd (the source) and reports/analysis.html (the render) are
# both tracked, so a reader can view the report without running anything.
# Regenerate both with `make all`; never edit either by hand.

.Rhistory
.RData
.Rproj.user/

# secrets / local
.env
.envrc
*.local
.DS_Store

# stray base-R graphics device output
Rplots.pdf
